# Polar API credentials (server-only, never expose in Vite VITE_* env vars)
POLAR_ACCESS_TOKEN=polar_oat_replace_me
POLAR_PRO_PRODUCT_ID=1ecb3420-88a4-4748-8dcb-a4d7d750443a
POLAR_WEBHOOK_SECRET=whsec_replace_me
# Optional: override the default ${APP_BASE_URL}/checkout/success?checkout_id={CHECKOUT_ID}
# POLAR_SUCCESS_URL=https://nekoscape.app/checkout/success?checkout_id={CHECKOUT_ID}
# Optional: set to "sandbox" when testing against https://sandbox-api.polar.sh/v1
# POLAR_SERVER=production

# Public website origin & base URL for Polar Checkout redirects and CORS/origin checks
APP_BASE_URL=https://nekoscape.app
ALLOWED_ORIGIN=https://nekoscape.app

# ECDSA P-256 (prime256v1) PKCS#8 PEM private key for signing NEKO-... Pro license keys
# Escape newlines as \n if storing in single-line environment variables.
NEKOSCAPE_LICENSE_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_P256_PKCS8_PRIVATE_KEY\n-----END PRIVATE KEY-----"

# High-entropy secret (>= 32 random bytes hex/base64) for deterministic HMAC order nonces
NEKOSCAPE_ORDER_SECRET=replace_with_at_least_32_bytes_of_random_entropy

# Optional: Resend transactional email delivery for webhook license backup emails
# RESEND_API_KEY=re_replace_me
# RESEND_FROM_EMAIL="NekoScape <licenses@nekoscape.app>"
